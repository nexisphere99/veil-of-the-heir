    <div class="user-item" @title="_item.name" onclick="$('#inventory-popup').fadeIn()" style="font-size: 0.7em;">
      [img[_item.img]]
      <small>[_item.amount]<em>[_item.unit]</em></small>
    </div>
  <</for>>
