/* Default: hide mobile toggle button */
#mobile-sidebar-toggle {
  display: none;
}

.mobile-close-btn {
  display: none;
  position: fixed;
  bottom: 10px;
  right: 20px;
  z-index: 1100;
  background: #6b4e2e;
  color: #fff8dc;
  border: 2px solid #5c3317;
  padding: 4px 8px;
  border-radius: 10px;
  font-family: 'Cinzel Decorative', serif;
  font-size: 1.1em;
}

/* Mobile view adjustments */
@media (max-width: 768px) {

  /* #right-ui-bar, */
  #right-sidebar {
    display: none !important;
  }

  #right-ui-bar {
    width: 0px;
  }

  #mobile-sidebar-toggle {
    display: block;
    position: fixed;
    bottom: 10px;
    right: 20px;
    z-index: 1100;
    background: #6b4e2e;
    color: #fff8dc;
    border: 2px solid #5c3317;
    padding: 8px 12px;
    border-radius: 8px;
    font-family: 'Cinzel Decorative', serif;
  }

  #right-sidebar.mobile-visible {
    display: flex !important;
    position: fixed;
    top: 0;
    right: 0;
    width: 55vw;
    height: 100vh;
    background-color: #1a0f0f;
    z-index: 1099;
    flex-direction: column;
    overflow-y: auto;
    padding: 10px;
  }

  #right-ui-bar button {
    font-size: 1.1em;
  }
}

@media (max-width: 768px) {
  .mobile-close-btn {
    display: block !important;
  }
}

#right-sidebar {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 20%;
  position: fixed;
  right: 0;
  top: 0;
  background-color: #1a0f0f;
  overflow: hidden;
}
/* twine-user-stylesheet #7: "style.css" */
html {
	cursor: url('images/game/cursor.png') 2 2, auto;
}

button:hover,
.link-internal:hover,
.macro-link:hover,
a:hover {
	cursor: url('images/game/pointer.png') 2 2, pointer;
}

button:hover,
.link-internal:hover,
.macro-link:hover {
	box-shadow: 0 0 10px #f0e68c;
	transform: scale(1.05);
	transition: all 0.2s ease-in-out;
}


body {
	background: url('images/game/background.png') repeat;
	background-size: cover;
	font-family: 'MedievalSharp', 'Cinzel Decorative', serif;
	color: #3e2f1c;
	margin: 0;

}

.passage {
	font-family: 'Papyrus', 'Georgia', serif;
	color: #5e3b1e;
	font-size: 15px;
    line-height: 1.5;
}

.passage img {
	max-width: 100%;
}

.change_show {
	top: 30%;
}

/* Font - Include Medieval Fonts */
@import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative&display=swap');
@import url('https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap');

/* Buttons */
button,
.link-internal,
.macro-link {
	background: linear-gradient(to bottom, #d2b48c, #a0522d);
	border: 3px solid #5c3317;
	border-radius: 12px;
	padding: 10px 10px;
	font-family: 'Cinzel Decorative', serif;
	font-size: 1.1em;
	color: #fff8dc;
	text-shadow: 1px 1px #000;
	cursor: url('images/game/pointer.png'), auto;
	transition: transform 0.2s, box-shadow 0.2s;
}

button:hover,
.link-internal:hover,
.macro-link:hover {
	transform: scale(1.05);
	box-shadow: 0 0 10px #ffd700;
}

/* Links */
a {
	color: #deb887;
	text-decoration: underline;
}

a:hover {
	color: #fffacd;
}


#story {
	align-self: center;
	margin-left: 25%;
	margin-right: 25%;
	width: 50%;
}

#passages {
	background-color: rgba(255, 248, 220, 0.85);
	border: 4px solid #6b4e2e;
	border-radius: 20px;
	padding: 20px;
	margin: 40px auto;
	max-width: 800px;
	box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
	width: 95%;
}

#ui-bar {
	background-color: #190f02;
	/* background-image: url('images/game/wall_2.png'); */
	background-repeat: repeat-y;
	background-size: 100% auto;
	/* Fit image width to sidebar, height scales automatically */
	border: none;
	font-family: 'Cinzel Decorative', serif;
	color: #f5deb3;
	width: 20%;
	border-right: 4px solid #8b5e3c;
	/* Decorative border */
}


#ui-bar img {
	width: 100%;
	height: auto;
	border-radius: 10px;
	margin-bottom: 10px;
}

#ui-bar-toggle {
	background-color: #6b4e2e;
	color: #f5deb3;
	border: 2px solid #fff8dc;
}


@media (max-width: 768px) {
	.item-grid {
		display: grid;
		grid-template-columns: repeat(1, 1fr) !important;
		gap: 1em;
	}
}


.item-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1em;
}

.item-card {
	border: 2px solid #ccc;
	border-radius: 8px;
	padding: 10px;
	text-align: center;
	color: #d2b48c;
	background: #322525;
}

.item-card .link-internal macro-link {
	text-decoration: none;
	color: #0a0702;
}

.item-card img {
	width: 100%;
	object-fit: contain;
	margin-bottom: 0.5em;
}

.item-card button {
	margin-top: 0.5em;
}

button,
.link-internal,
.macro-link {
	text-decoration: none;
	border: none;
}

.item-card .macro-link {
	text-decoration: none;
	border: none;
	border-radius: 12px;
	padding: 10px 15px;
	font-size: 0.8em;
	color: #eec10e;
}

.ingredient_details .macro-link {
	text-decoration: none;
	border: none;
	border-radius: 12px;
	padding: 0 0;
	font-size: 0.8em;
	background: none;
	color: #eec10e;
}



#ui-bar-toggle {
	display: none !important;
}

#ui-bar {
	display: none;
}

#custom-popup-1 {
	display: none;
	position: fixed;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	width: 25%;
	max-width: 700px;
	background-color: #f5f0dc;
	color: #8b5e3c;
	font-family: 'Papyrus', serif;
	font-size: 20px;
	padding: 18px;
	border: 2px solid #a58b5c;
	border-radius: 10px;
	z-index: 1000;
	text-align: left;
	box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.2);
}

@media (max-width: 768px) {
	#custom-popup-1 {
		width: 70vw;
	}
}

#custom-popup-1 li{
	border: none !important;
}
#custom-popup-1 ul {
	border: none !important;
}

#custom-popup-1 li a {
	text-decoration: none;
	color: #8b5e3c;
	text-align: center;
	border: none !important;
}

#story-title {
	text-align: center;
	font-size: 2em;
	margin-bottom: 20px;
	color: #6f4e37;
}
#custom-popup-1 h3 {
	font-size: 24px;
	text-align: center;
	margin-bottom: 15px;
	color: #6f4e37;
}

#popup-close-1 {
	display: block;
	margin: 20px auto 0;
	padding: 8px 15px;
	background: #a54c4c;
	color: white;
	border: none;
	border-radius: 5px;
	text-align: center;
	font-size: 16px;
	font-family: inherit;
}

#popup-button-1 {
	position: fixed;
	top: 10px;
	left: 10px;
	background: #a58b5c;
	color: white;
	padding: 8px 12px;
	border: none;
	z-index: 1001;
	font-size: 18px;
	border-radius: 5px;
	font-family: 'Papyrus', serif;
}

.choice-layers {
	display: grid;
	position: relative;
}

.choice-layer {
	grid-area: 1 / 1;
}



@media (max-width: 768px) {
	#passages {
		width: 70vw;
		margin: 0px;
	}

	#story {
		margin-left: 0px;
		width: 70vw;
	}

	.passage {
		font-size: smaller !important;
	}
}

.topic-head {
	font-size: 24px;
	color: #6e421c;
}


#intro {
    font-family: 'Papyrus', serif;
    font-size: 20px;
    color: #8b5e3c;
    background-color: #f5f0dc;
    border: 2px solid #a58b5c;
    padding: 18px;
    border-radius: 10px;
    box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.2);
    max-width: 700px;
    text-align: center;
}

@media (max-width: 768px) {
	body {
		font-size: smaller;
	}

	.character-text {
		font-size: smaller;
	}

	button, .link-internal, .macro-link {
		font-size: 60%;
		padding: 7px 5px;
	}

	.topic-head {
		font-size: large;
		color: #6e421c;
	}


	#intro {
		font-family: 'Papyrus', serif;
		font-size: 1em;
		color: #8b5e3c;
		background-color: #f5f0dc;
		border: 2px solid #a58b5c;
		padding: 1.2em;
		border-radius: 10px;
		box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.2);
		max-width: 700px;
		width: 100%;
		text-align: center;
	}
}
/* twine-user-stylesheet #8: "Story Stylesheet" */
/* <!--interact_with_mage_2 --> */


