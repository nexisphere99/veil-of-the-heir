.character-image-dialog {
    width: 120px;
    height: 120px; /* smaller height to crop lower parts */
    overflow: hidden; /* hides overflow from zoom */
    position: relative;
    border-radius: 8px;
    border: 2px solid #6e421c;
    box-shadow: 2px 2px 6px rgba(0,0,0,0.3);
    background-color: #e8dcc2;
}

.layer-container {
    position: relative;
    width: 100%;
    height: 100%;
    transform: scale(1.6); /* ZOOM LEVEL */
    transform-origin: top center; /* Zoom from top */
}

.layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
}

@media (max-width: 768px) {
	.character-image-dialog{
		width: 60px;
		height: 60px;
	}
	.character-column{
		width: 60px;
	}
	.character-name {
		font-size: x-small;
	}
}



/* twine-user-stylesheet #2: "custom_left_side_bar.css" */
/* Custom Left Sidebar */
#custom-left-bar {
    position: fixed;
    left: 0;
    top: 0;
    width: 22%;
    height: 100%;
    background: #190f02;
    color: #f5deb3;
    border-right: 4px solid #8b5e3c;
    font-family: 'Cinzel Decorative', serif;
    box-shadow: -4px 0 10px rgba(0, 0, 0, 0.5);
    /* overflow-y: auto; */
    display: flex;
    flex-direction: column;
}

/* Top Section: Player Image & Stats */
#left-top-container {
    margin-top: 10px;
    width: 80%;
    aspect-ratio: 1 / 1; /* Keeps it square */
    overflow: hidden;
    position: relative;
    background: linear-gradient(#2e1a0f, #1a0e06); /* Dark wood gradient */
    border: 10px ridge #8b5e3c;  /* Textured outer border */
    border-radius: 14px;
    box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.5);
    align-self: center;
}

/* Player Image (Left) */
.player-image {
    position: absolute;
    border-radius: 10px;
    /* background: tan; */
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transform: scale(1.5); /* 200% zoom */
    margin-top: 20%;
}

/* Player Stats (Right) */
#player-stats {
    width: 62%;
    height: 88%;
    padding: 2%;
    margin-top: 2%;
    margin-right: 2%;
    background: rgba(50, 50, 50, 0.8);
    text-align: center;
    border-radius: 10px;
    color: white;
}

/* Bottom Section: Player Location */
#player-map {
    position: absolute;
    bottom: 10px;
    width: 94%;
    /* height: 30%; */
    margin-left: 2%;
    margin-right: 2%;
    text-align: center;
    padding: 1%;
    border-radius: 10px;
    color: white;
}

#player-map img {
    width: 100%;
    height: 100%;
    border-radius: 9px;
    border: 10px ridge #8b5e3c;  /* Textured outer border */
}




/* Overlay background */
#image-popup-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 10, 5, 0.8);
    z-index: 1000;
}

/* Popup container */
#image-popup-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 10px solid #7b4e1d;
    box-shadow: 0 0 30px #000;
    background: #fffbe6;
    padding: 10px;
    max-width: 90%;
    max-height: 90%;
    /* border-image: url('your-medieval-frame.png') 30 round; */
}

/* Popup image */
#popup-image {
    max-width: 100%;
    max-height: 100%;
    display: block;
    margin: auto;
}

#image-popup-close {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 28px;
    color: #7b4e1d;
    font-weight: bold;
    z-index: 1001;
    background-color: #f8e4c4;
    border: 2px solid #7b4e1d;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    text-align: center;
    line-height: 28px;
    box-shadow: 2px 2px 4px #000;
}
#image-popup-close:hover {
    background-color: #e6d2b5;
}



/* Show/hide based on screen size */
.mobile-only {
    display: none;
}

@media (max-width: 768px) {
    #custom-left-bar {
        display: none;
        position: fixed;
        width: 55vw;
        height: 100%;
        z-index: 2000;
        overflow-y: auto;
        padding: 20px;
    }

    #menu-toggle {
        display: block;
        position: fixed;
        bottom: 10px;
        left: 20px;
        z-index: 1100;
        background: #6b4e2e;
        color: #fff8dc;
        border: 2px solid #5c3317;
        padding: 4px 8px;
        border-radius: 10px;
        font-family: 'Cinzel Decorative', serif;
        font-size: 1.1em;
    }

    #sidebar-close {
        display: block;
        position: fixed;
        bottom: 10px;
        left: 20px;
        z-index: 1100;
        background: #6b4e2e;
        color: #fff8dc;
        border: 2px solid #5c3317;
        padding: 4px 8px;
        border-radius: 10px;
        font-family: 'Cinzel Decorative', serif;
        font-size: 1.1em;
    }


    #left-top-container {
        margin-left: 8%;
    }



    #player-map img {
        margin-bottom: 10%;
        margin-right: 10%;
        width: 80% !important;
    }
}

/* twine-user-stylesheet #3: "ingredients.css" */
.ingredients-main-img img {
    border-radius: 10px;
    border: 2px solid #8b5e3c;
}

.ingredient_text{
    font-family: 'Papyrus', 
    serif; font-size: 22px; 
    color: #8b5e3c;
}

@media (max-width: 768px) {
    #passage-ingredient-selection .item-grid {
        grid-template-columns: repeat(3, 1fr) !important;
        justify-content: center;
    }

    .ingredient_text{
        font-family: 'Papyrus', 
        serif; font-size: small; 
        color: #8b5e3c;
    }

    .item-card .macro-link {
        padding: 4px 6px !important;
    }

    #passage-potion-create-hair .item-grid {
        grid-template-columns: repeat(3, 1fr) !important;
        justify-content: center;
    }

    #passage-potion-create-hair .item-card img {
        width: 50px !important;
    }
}
/* twine-user-stylesheet #4: "map.css" */
polygon.bodypart {
	fill: transparent;
	stroke: gold;
	stroke-width: 2;
	transition: all 0.3s ease;
}

polygon.bodypart:hover {
	fill: rgba(255, 215, 0, 0.3);
	/* gold glow */
	filter: drop-shadow(0 0 8px gold);
	cursor: url('images/game/pointer.png') 2 2, pointer;
}

polygon.bodypart.active {
	fill: rgba(255, 215, 0, 0.6);
	filter: drop-shadow(0 0 12px gold);
}

polygon.castle_back_map {
	fill: transparent;
	stroke: gold;
	stroke-width: 2;
	transition: all 0.3s ease;
}

polygon.castle_back_map:hover {
	fill: rgba(255, 215, 0, 0.3);
	/* gold glow */
	filter: drop-shadow(0 0 8px gold);
	cursor: url('images/game/pointer.png') 2 2, pointer;
}

polygon.castle_back_map.active {
	fill: rgba(255, 215, 0, 0.6);
	filter: drop-shadow(0 0 12px gold);
}

polygon.castle_front_map {
	fill: transparent;
	stroke: gold;
	stroke-width: 2;
	transition: all 0.3s ease;
}

polygon.castle_front_map:hover {
	fill: rgba(255, 215, 0, 0.3);
	/* gold glow */
	filter: drop-shadow(0 0 8px gold);
	cursor: url('images/game/pointer.png') 2 2, pointer;
}

polygon.castle_front_map.active {
	fill: rgba(255, 215, 0, 0.6);
	filter: drop-shadow(0 0 12px gold);
}

polygon.mc_bed_chamber_map {
	fill: transparent;
	stroke: gold;
	stroke-width: 2;
	transition: all 0.3s ease;
}

polygon.mc_bed_chamber_map:hover {
	fill: rgba(255, 215, 0, 0.3);
	/* gold glow */
	filter: drop-shadow(0 0 8px gold);
	cursor: url('images/game/pointer.png') 2 2, pointer;
}

polygon.mc_bed_chamber_map.active {
	fill: rgba(255, 215, 0, 0.6);
	filter: drop-shadow(0 0 12px gold);
}

#gif_pop_up {
	position: fixed;
	top: 0; left: 0;
	width: 100%; 
	height: 100%;
	background: rgba(0,0,0,0.75);
	display: flex; align-items: center; justify-content: center;
	z-index: 9999;
	flex-direction: column;
}

#gif_pop_up img {
	width: 700px;
	height: 500px;
	border-radius: 10px;
}
/* twine-user-stylesheet #5: "north_forest.css" */



.monster_information {
    font-family: 'Papyrus', 
    serif; font-size: 22px; 
    color: #8b5e3c;
}
/* twine-user-stylesheet #6: "right_side_bar.css" */
#right-ui-bar {
  position: fixed;
  top: 0;
  right: 0;
  width: 250px;
  height: 100%;
  background: #190f02;
  /* Rich dark brown */
  color: #f5deb3;
  /* Wheat / parchment color text */
  border-left: 4px solid #8b5e3c;
  /* Decorative border */
  font-family: 'Cinzel Decorative', serif;
  box-shadow: -4px 0 10px rgba(0, 0, 0, 0.5);
  overflow-y: auto;
  z-index: 1000;
  width: 20%;
}

#right-ui-bar h2,
#right-ui-bar h3 {
  font-family: 'MedievalSharp', serif;
  font-weight: bold;
  border-bottom: 2px solid #deb887;
  margin-bottom: 10px;
  padding-bottom: 4px;
}

#right-ui-bar a {
  color: #fff8dc;
  text-decoration: none;
}

#right-ui-bar a:hover {
  color: #ffd700;
  text-shadow: 0 0 5px #ffeb99;
}

#right-ui-bar ul {
  list-style: square inside;
  padding-left: 0;
}

#right-ui-bar button {
  background: linear-gradient(to bottom, #a67c52, #6b4e2e);
  border: 2px solid #5c3317;
  color: #fff8dc;
  padding: 2px 4px;
  border-radius: 10px;
  font-family: 'Cinzel Decorative', serif;
  transition: all 0.2s ease;
}

#right-ui-bar button:hover {
  background: #deb887;
  color: #3e2f1c;
  box-shadow: 0 0 6px #ffd700;
}


.avatar {
  position: absolute;
}

.avatar.head {
  z-index: 190;
}

.avatar.hair {
  z-index: 250;
}

.avatar.torso {
  z-index: 1;
}

.avatar.right_hand {
  z-index: 5;
}

.avatar.left_hand {
  z-index: 5;
}

.avatar.right_leg {
  z-index: 5;
}

.avatar.left_leg {
  z-index: 5;
}

.avatar.crotch {
  z-index: 51;
}

.avatar.chest {
  z-index: 50;
}

.avatar.top_underwear {
  z-index: 100;
}

.avatar.bottom_underwear {
  z-index: 100;
}
.avatar.top_middlewear {
  z-index: 195;
}

.avatar.bottom_middlewear {
  z-index: 195;
}

.avatar.top_wear {
  z-index: 200;
}

.avatar.bottom_wear {
  z-index: 200;
}

.avatar.shoes {
  z-index: 199;
}

.avatar img {
  width: 70%;
  /* height: 450px; */
}


.user-item {
  margin-bottom: 4px;
}

.user-item img {
  margin-right: 8px;
  width: 20px;
  height: 20px;
  vertical-align: middle;
}

#inventory-popup h2 {
  font-family: "Uncial Antiqua", serif;
  font-size: 1.5em;
}


.inventory-card {
  background-color: #1a1a22;
  border: 1px solid #444;
  border-radius: 8px;
  padding: 10px;
  color: #eee;
  text-align: center;
  font-size: 0.9em;
  box-shadow: 0 0 5px #000;
}

.inventory-card .item-img {
  font-size: 1.8em;
  margin-bottom: 4px;
}

.inventory-card .item-img img {
  width: 100%;
  height: auto;
  max-width: 80px;
  /* Adjust to your preferred image size */
  margin-bottom: 8px;
}

.inventory-card .item-name {
  font-weight: bold;
  margin-bottom: 2px;
  color: #f0e6d2;
}

.inventory-card .item-info {
  font-size: 0.8em;
  color: #ccc;
}


.change_show {
  position: absolute;
  width: 100%;
  left: 0%;
  top: 10%;
}



