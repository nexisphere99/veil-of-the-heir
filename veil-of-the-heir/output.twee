:: Story Stylesheet [stylesheet]
/* twine-user-stylesheet #1: "character.css" */
/* speech */
.speech-box {
    display: flex;
    align-items: flex-start;
    background-color: #f5f0dc;
    border: 3px solid #a58b5c;
    padding: 4px 5px;
    border-radius: 12px;
    box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.2);
    max-width: 700px;
    font-family: 'Papyrus', 'Georgia', serif;
    color: #5e3b1e;
    position: relative;
}

.character-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 20px;
    width: 120px;
}

.character-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 2px solid #6e421c;
    box-shadow: 2px 2px 6px rgba(0,0,0,0.3);
    background-color: #e8dcc2;
}

.character-name {
    font-size: 14px;
    color: #6e421c;
    text-align: center;
    font-style: italic;
}

.dialog-content {
    flex: 1;
}

.character-text {
    font-size: 18px;
    line-height: 1.5;
	padding-right: 20px;
}

/* Optional medieval decoration */
.alinora::after {
    content: "👑";
    position: absolute;
    top: -12px;
    right: -12px;
    background-color: #f5f0dc;
    border: 2px solid #a58b5c;
    border-radius: 50%;
    padding: 5px;
    font-size: 18px;
    box-shadow: 1px 1px 4px rgba(0,0,0,0.2);
}

.therion::after {
