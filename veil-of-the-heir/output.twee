:: Lean {"position":"350,20225","size":"100,100"}
<<nobr>>
<<set $user_stats.gender_Identity = 60>>
<<set $user_stats.gender_appearance = 64.5>>
<<set $user_stats.dominance_level = 60>>
<div class="item-grid">
    <br>
	<div class="item-card" style="width: 90%;">
